# Salin file ini menjadi backend/.env lalu isi nilainya.
#   Windows : copy backend\.env.example backend\.env
#   Linux   : cp backend/.env.example backend/.env
#
# backend/.env sudah masuk .gitignore, jadi TIDAK ikut ter-commit.
# Jangan pernah menaruh key di frontend (NEXT_PUBLIC_*), karena key akan
# terkirim ke browser dan bisa dicuri.

# Key gratis bisa dibuat di https://aistudio.google.com/apikey
# Kosongkan bila belum punya: fitur saran tetap berjalan memakai
# mode "rule_based" (saran standar tanpa memanggil Gemini).
GEMINI_API_KEY=

# Model Gemini yang dipakai untuk endpoint /api/advice.
GEMINI_MODEL=gemini-2.0-flash
