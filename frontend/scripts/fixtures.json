{
  "project": "ProfitLeak AI",
  "version": "v6",
  "contract_threshold": 3.09779,
  "margin_threshold": 0.46,
  "currency": "BRL",
  "valid_ranges": {
    "weight_kg": [0.05, 30.0],
    "distance_km": [1.4896, 3135.7885],
    "volume_cm3": [352.0, 244608.0],
    "price": [4.99, 2110.0]
  },
  "test_cases": {
    "normal_sample": {
      "description": "Pengiriman wajar: ongkir rendah dan tidak menggerus margin",
      "input": {
        "weight_kg": 1.5,
        "distance_km": 150.0,
        "volume_cm3": 5000.0,
        "price": 150.0,
        "actual_rate": 20.0
      },
      "expected": {
        "is_leak": false,
        "status_code": 200
      }
    },
    "rate_leak_sample": {
      "description": "Tarif aktual melonjak jauh di atas estimasi wajar model (rasio > 3.09779)",
      "input": {
        "weight_kg": 1.5,
        "distance_km": 150.0,
        "volume_cm3": 5000.0,
        "price": 400.0,
        "actual_rate": 180.0
      },
      "expected": {
        "is_leak": true,
        "reason_code": "rate_exceeds_fair",
        "status_code": 200
      }
    },
    "margin_leak_sample": {
      "description": "Ongkir menyerap porsi besar dari harga jual (freight > 50% price)",
      "input": {
        "weight_kg": 5.0,
        "distance_km": 1000.0,
        "volume_cm3": 20000.0,
        "price": 30.0,
        "actual_rate": 35.0
      },
      "expected": {
        "is_leak": true,
        "reason_code": "freight_eats_margin",
        "status_code": 200
      }
    },
    "boundary_min_valid": {
      "description": "Batas minimum valid (semua parameter di batas bawah)",
      "input": {
        "weight_kg": 0.05,
        "distance_km": 1.5,
        "volume_cm3": 352.0,
        "price": 5.0,
        "actual_rate": 5.0
      },
      "expected": {
        "status_code": 200
      }
    },
    "boundary_max_valid": {
      "description": "Batas maksimum valid (semua parameter di batas atas)",
      "input": {
        "weight_kg": 30.0,
        "distance_km": 3135.0,
        "volume_cm3": 244600.0,
        "price": 2110.0,
        "actual_rate": 200.0
      },
      "expected": {
        "status_code": 200
      }
    },
    "invalid_weight_low": {
      "description": "Input berat di bawah 0.05 kg (harus ditolak HTTP 400)",
      "input": {
        "weight_kg": 0.01,
        "distance_km": 100.0,
        "volume_cm3": 1000.0,
        "price": 20.0
      },
      "expected": {
        "status_code": 400
      }
    },
    "invalid_weight_high": {
      "description": "Input berat di atas 30.0 kg (harus ditolak HTTP 400)",
      "input": {
        "weight_kg": 35.0,
        "distance_km": 100.0,
        "volume_cm3": 1000.0,
        "price": 20.0
      },
      "expected": {
        "status_code": 400
      }
    },
    "invalid_distance_high": {
      "description": "Input jarak melebihi 3135.79 km (harus ditolak HTTP 400)",
      "input": {
        "weight_kg": 2.0,
        "distance_km": 4000.0,
        "volume_cm3": 2000.0,
        "price": 30.0
      },
      "expected": {
        "status_code": 400
      }
    },
    "invalid_price_low": {
      "description": "Input harga di bawah 4.99 BRL (harus ditolak HTTP 400)",
      "input": {
        "weight_kg": 1.0,
        "distance_km": 100.0,
        "volume_cm3": 1000.0,
        "price": 2.0
      },
      "expected": {
        "status_code": 400
      }
    }
  }
}
